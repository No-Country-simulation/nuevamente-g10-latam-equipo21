# Variables de Compose, no del backend. No contiene contraseñas.
# Copiar a .env únicamente en el entorno de despliegue.
NUEVAMENTE_BACKEND_IMAGE=nuevamente-backend:VERSION_BACKEND
NUEVAMENTE_FRONTEND_IMAGE=nuevamente-frontend:VERSION_FRONTEND
NUEVAMENTE_AUTH_IMAGE=nuevamente-auth:VERSION_AUTH
NUEVAMENTE_PUBLIC_HOST=nuevamente.example.com
NUEVAMENTE_BACKEND_ENV_FILE=/etc/docker-platform/apps/nuevamente/runtime.env
NUEVAMENTE_AUTH_SECRETS_DIR=/etc/docker-platform/apps/nuevamente/auth-secrets
