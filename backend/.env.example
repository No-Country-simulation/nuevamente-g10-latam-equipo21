# ==========================================
# Configuración del Backend NuevaMente
# ==========================================
# Copiar este archivo como .env y completar los valores necesarios:
# cp .env.example .env

# Entorno general
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME="NuevaMente API"
VERSION=0.1.0

# Activa el endpoint mock de POST /api/v1/adaptar-contenido (NM-18).
# En false, ese endpoint responde 501 hasta que NM-12 implemente la pipeline real.
USE_MOCK_LLM=true

# CORS (Orígenes permitidos, ej. Streamlit en localhost:8501)
CORS_ORIGINS=["http://localhost:8501", "http://127.0.0.1:8501"]

# Google Gemini LLM
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL_NAME=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL_NAME=gemini-embedding-001
# Timeout (segundos) para cada llamada al proveedor LLM (NM-08). Ante un timeout, la capa
# llm_provider debe levantar un error tipado en vez de dejar la petición colgada.
GEMINI_TIMEOUT_SECONDS=30

# ChromaDB (Vector Store local embebido)
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Recuperación semántica (NM-06)
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.35
RETRIEVAL_MAX_CONTEXT_TOKENS=2000

# OCI Object Storage (Oracle Cloud Infrastructure)
# Desarrollo local: API key cargada únicamente desde el .env ignorado por Git.
# OCI Compute: cambiar a instance_principal y dejar vacíos los campos de API key.
OCI_AUTH_MODE=api_key
OCI_NAMESPACE=tu_namespace_oci_aqui
OCI_BUCKET_NAME=nuevamente-contenidos-educativos
OCI_REGION=sa-saopaulo-1

# Desarrollo local opcional con OCI_AUTH_MODE=api_key.
# Completar sólo en el .env local; nunca versionar valores reales ni la clave privada.
OCI_USER_OCID=
OCI_TENANCY_OCID=
OCI_FINGERPRINT=
OCI_KEY_FILE=
OCI_KEY_PASSPHRASE=
