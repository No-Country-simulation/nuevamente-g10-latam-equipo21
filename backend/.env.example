# ==========================================
# Configuración del Backend NuevaMente
# ==========================================
# Copiar este archivo como .env y completar los valores necesarios:
# cp .env.example .env

# Entorno general
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME="NuevaMente API"
VERSION=0.1.0

# CORS (Orígenes permitidos, ej. Streamlit en localhost:8501)
CORS_ORIGINS=["http://localhost:8501", "http://127.0.0.1:8501"]

# Google Gemini LLM
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL_NAME=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL_NAME=gemini-embedding-001

# ChromaDB (Vector Store local embebido)
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Recuperación semántica (NM-06)
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.35
RETRIEVAL_MAX_CONTEXT_TOKENS=2000

# OCI Object Storage (Oracle Cloud Infrastructure)
# Desarrollo local: APIKey mediante ~/.oci/config o variables cargadas por NM-11.
# OCI Compute: usar OCI_AUTH=InstancePrincipal y dejar vacios los campos de API key.
OCI_AUTH=APIKey
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_USER_OCID=ocid1.user.oc1..reemplazar
OCI_TENANCY_OCID=ocid1.tenancy.oc1..reemplazar
OCI_FINGERPRINT=00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00
OCI_KEY_FILE=~/.oci/oci_api_key.pem
OCI_KEY_PASSPHRASE=
OCI_NAMESPACE=tu_namespace_oci_aqui
OCI_BUCKET_NAME=nuevamente-contenidos-educativos
OCI_REGION=sa-saopaulo-1
