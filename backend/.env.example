# ==========================================
# Configuración del Backend NuevaMente
# ==========================================
# Plantilla canónica para desarrollo local y despliegue en OCI Compute.
# Desarrollo local: copiar este archivo como .env y completar los valores necesarios:
# cp .env.example .env
# OCI Compute: crear /etc/docker-platform/apps/nuevamente/runtime.env únicamente
# con los valores reales requeridos. Docker Compose define las opciones propias
# de producción y la VM se autentica en OCI mediante Instance Principal.

# Entorno general
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME="NuevaMente API"
VERSION=0.1.0

# Activa el endpoint mock de POST /api/v1/adaptar-contenido (NM-18).
# true: responde con datos de ejemplo, sin ejecutar RAG ni LLM, y NO persiste ningún objeto en OCI
#       (la respuesta trae status_upload="error" y objeto_id="mock-no-persistido").
# false: ejecuta la pipeline real (NM-12), que sí intenta persistir en OCI.
USE_MOCK_LLM=true

# CORS (Orígenes permitidos, ej. Streamlit en localhost:8501)
CORS_ORIGINS=["http://localhost:8501", "http://127.0.0.1:8501"]

# Google Gemini LLM
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL_NAME=gemini-3.8-flash
# NM-D4: cada imagen candidata de un PDF genera una solicitud multimodal adicional.
# Tras filtrar imágenes pequeñas, superar este máximo rechaza el documento antes de invocar Gemini.
DIAGRAM_MAX_IMAGES_PER_DOCUMENT=10
# Descarta íconos y logos pequeños antes de consumir cuota multimodal.
DIAGRAM_MIN_IMAGE_AREA_PIXELS=10000
# Opcional: se usa solo ante errores 429/503 del modelo principal.
# Debe ser distinto de GEMINI_MODEL_NAME; vacío desactiva el respaldo.
# Respaldo configurado en la demo OCI: gemini-3.5-flash-lite (verificado el 28/10/2026).
# Para otro entorno, validar disponibilidad y esquemas antes de activarlo.
GEMINI_FALLBACK_MODEL_NAME=
GEMINI_EMBEDDING_MODEL_NAME=gemini-embedding-001
# Timeout (segundos) para cada llamada al proveedor LLM (NM-08). Ante un timeout, la capa
# llm_provider debe levantar un error tipado en vez de dejar la petición colgada.
GEMINI_TIMEOUT_SECONDS=30

# ChromaDB (Vector Store local embebido)
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Recuperación semántica (NM-06)
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.35
RETRIEVAL_MAX_CONTEXT_TOKENS=6000
RETRIEVAL_MAX_VENTANAS=10
RETRIEVAL_VENTANA_CHARS=2000
RETRIEVAL_VENTANA_CANDIDATOS=8
RETRIEVAL_FRAGMENTOS_POR_VENTANA=2

# Fidelidad (NM-09/NM-32): umbral para logs y advertencias públicas (entre 0 y 1).
FIDELITY_SCORE_THRESHOLD=0.7
# NM-32: mínimo preventivo de palabras en la fuente para el pipeline real.
DOCUMENT_MIN_WORDS=30

# LangGraph multi-agente (NM-D1/NM-28). Con USE_MOCK_LLM=false, USE_MULTIAGENT=true
# selecciona el grafo desde el endpoint; false mantiene el pipeline lineal por defecto.
MULTI_AGENT_MAX_ITERATIONS=3
USE_MULTIAGENT=false

# OCI Object Storage (Oracle Cloud Infrastructure)
# Desarrollo local: usar api_key y completar los campos de credencial en el .env ignorado por Git.
# OCI Compute: usar instance_principal y dejar vacíos los campos de API key.
OCI_AUTH_MODE=api_key
OCI_NAMESPACE=tu_namespace_oci_aqui
OCI_BUCKET_NAME=nuevamente-contenidos-educativos
OCI_REGION=sa-saopaulo-1

# Desarrollo local con OCI_AUTH_MODE=api_key.
# Completar solo en el .env local; nunca versionar valores reales ni la clave privada.
OCI_USER_OCID=
OCI_TENANCY_OCID=
OCI_FINGERPRINT=
OCI_KEY_FILE=
OCI_KEY_PASSPHRASE=
